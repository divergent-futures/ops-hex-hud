# Normalise to LF in the repo; Git may check out CRLF on Windows if core.autocrlf
# says so, but nothing in history ever gains CRLF. Without this, a push from
# Windows can rewrite every text file as a line-ending-only diff.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.ps1   text eol=crlf

*.png   binary
*.jpg   binary
*.pdf   binary
*.zip   binary
*.bundle binary
